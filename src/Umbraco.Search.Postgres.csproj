<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>Umbraco Semantic Search Postgres Provider</Title>
        <RootNamespace>Fynydd.Umbraco.Search.Postgres</RootNamespace>

        <AssemblyVersion>18.0.0</AssemblyVersion>
        <FileVersion>18.0.0</FileVersion>
        <PackageVersion>18.0.0</PackageVersion>

        <PackageId>fynydd.umbraco.search.postgres</PackageId>
        <Authors>Fynydd LLC</Authors>
        <Company>Fynydd LLC</Company>
        <Description>Postgres and pgvector storage for Umbraco semantic search.</Description>
        <Copyright>Copyright (c) 2026 Fynydd LLC</Copyright>
        <PackageTags>umbraco;postgres;postgresql;pgvector;semantic-search;vector-search</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReleaseNotes>Initial Postgres and pgvector provider for Umbraco 18.</PackageReleaseNotes>
        <PackageIcon>nuget-icon.png</PackageIcon>
        <PackageOutputPath>nupkg</PackageOutputPath>
        <PackageProjectUrl>https://github.com/fynydd/Fynydd.Umbraco.Search.Postgres</PackageProjectUrl>
        <RepositoryUrl>https://github.com/fynydd/Fynydd.Umbraco.Search.Postgres</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" Version="10.0.4" />
        <PackageReference Include="Pgvector" Version="0.3.2" />
        <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
        <PackageReference Include="Umbraco.AI.Search" Version="18.0.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- These override Umbraco dependencies with security vulnerabilities -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
        <PackageReference Include="MessagePack.AspNetCoreMvcFormatter" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
        <None Include="nuget-icon.png" Pack="true" PackagePath="" CopyToOutputDirectory="Always" />
        <None Include="appsettings-schema.Umbraco.Search.Postgres.json" Pack="true" PackagePath="contentFiles/any/any/;content/" CopyToOutputDirectory="Always" />
        <None Include="..\README.md" Pack="true" PackagePath="" CopyToOutputDirectory="Always" />
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="" CopyToOutputDirectory="Always" />
    </ItemGroup>
    
</Project>
