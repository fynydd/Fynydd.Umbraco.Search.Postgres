{
    "Umbraco": {
        "AI": {
            "Search": {
                "Postgres": {
                    "DisableDefaultIndex": true,
                    "Connection": {
                        "ServerAddress": "localhost",
                        "ServerPort": 5432,
                        "DatabaseName": "umbraco_search",
                        "Username": "umbraco_search",
                        "Password": "",
                        "SslMode": "Prefer",
                        "SchemaName": "public",
                        "EmbeddingSize": 1024,
                        "RequestTimeoutSeconds": 30,
                        "InitializationTimeoutSeconds": 5
                    },
                    "Categories": {
                        "Documentation": {
                            "IndexAlias": "Documentation",
                            "EmbeddingsProfileAlias": "embeddings",
                            "ChunkSize": 150,
                            "ChunkOverlap": 25,
                            "TopK": 150,
                            "Take": 15,
                            "MinScore": 0.2,
                            "Indexing": [
                                {
                                    "DocumentTypeAliases": [
                                        "docPage",
                                        "docsPage"
                                    ],
                                    "SearchText": {
                                        "MarkdownTemplate": "# {headline|heroHeadline|Name:3}\n\n> {Breadcrumb}\n\n## Summary\n\n{heroIntroductionText:2}\n\n## Body\n\n{blockContent}\n\n{Url}"
                                    },
                                    "Chunking": {
                                        "UseHeadingAwareChunking": true,
                                        "Context": {
                                            "CategoryPropertyAliases": [
                                                "heroCategory"
                                            ],
                                            "TitlePropertyAliases": [
                                                "headline",
                                                "heroHeadline"
                                            ],
                                            "SectionTitlePropertyAliases": [
                                                "heroIntroductionText"
                                            ],
                                            "AdditionalPropertyAliases": []
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    }
}
